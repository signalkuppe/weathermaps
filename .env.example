# Map area: lat_min,lat_max,lon_min,lon_max (longitudes -180..180)
BBOX=42,49,4,17
# Initial view (default Lombardy), same format; cropped inside BBOX
INITIAL_VIEW=44.68,46.64,8.50,11.43
# Folder where downloaded data are stored
DATA_DIR=./data
# Automatic updates (0 to disable)
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_MIN=10
LOG_LEVEL=INFO
# Thunderforest key (https://manage.thunderforest.com) for the "Rilievo" (Outdoors) basemap
THUNDERFOREST_KEY=
