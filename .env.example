# Area della mappa: lat_min,lat_max,lon_min,lon_max (longitudini -180..180)
BBOX=42,49,4,17
# Vista iniziale (default Lombardia), stesso formato; viene ritagliata dentro BBOX
INITIAL_VIEW=44.68,46.64,8.50,11.43
# Dove salvare i dati (su Railway: punto di montaggio del volume)
DATA_DIR=./data
# Corse da tenere per modello
RETENTION=2
# File con i punti fissi (default ./points.json)
# POINTS_FILE=./points.json
# Aggiornamento automatico (0 per disattivarlo)
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_MIN=10
LOG_LEVEL=INFO
